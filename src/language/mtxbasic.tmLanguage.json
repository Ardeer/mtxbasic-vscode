{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mtxbasic",
  "scopeName": "source.mtxbasic",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" }
  ],
  "repository": {
    "keywords": {
            "patterns": [
          {
            "name": "keyword.control.mtxbasic",
            "match": "\\b(CONT|ELSE|FOR|GOSUB|GOTO|IF|NEXT|ON|PAUSE|RETURN|STEP|STOP|THEN|TO)\\b"
          },
          {
            "name": "keyword.command.mtxbasic",
            "match": "\\b(ADJSPR|ANGLE|ARC|ATTR|BAUD|CIRCLE|CLOCK|CLEAR|CLS|COLOUR|CRVS|CSR|CTLSPR|DATA|DIM|DRAW|DSI|EDITOR|GENPAT|INK|INPUT|LEN|LET|LINE|LLIST|LPRINT|MVSPR|OUT|PAPER|PEEK|PHI|PI|PLOD|PLOT|POKE|PRINT|RAND|READ|REM|RESTORE|RND|SBUF|SOUND|SPRITE|USER|VIEW|VS)\\b"
          },
          {
            "name": "keyword.other.mtxbasic",
            "match": "\\b(CHR\\$|GR\\$|INKEY\\$|LEFT\\$|MID\\$|RIGHT\\$|SPK\\$|STR\\$|TIME\\$)\\b"
          },
          {
            "name": "entity.name.function.mtxbasic",
            "match": "\\b(ABS|ASC|ATN|COS|EXP|INP|INT|LN|MOD|SGN|SIN|SQR|TAN|USR|VAL)\\b"
          },           
          {
            "name": "illegal.keyword.control.mtxbasic",
            "match": "\\b(ASSEM|AUTO|EDIT|EDITOR|FRE|LIST|LLIST|LOAD|NEW|NODDY|PANEL|RUN|SAVE|VERIFY)\\b"
          },
          {
            "name": "constant.numeric.line-number.mtxbasic",
            "match": "^(\\d{1,5})(?=\\s)"
          },
          {
            "name": "keyword.operator.arithmetic.mtxbasic",
            "match": "(\\+|\\-|\\*|/|\\^)"
          },
          {
            "name": "meta.brackets.parenthesis.mtxbasic",
            "match": "(\\(|\\))"
          },
          {
            "name": "keyword.operator.boolean.mtxbasic",
            "match": "\\b(AND|NOT|OR)\\b"
          },
          {
            "name": "keyword.operator.relational.mtxbasic",
            "match":"(<>|<=|>=|=|<|>)"
          },
          {
            "name": "comment.line.rem.mtxbasic",
            "match": "(?<=:(\\bREM\\b|').*)"
          },
          {
             "name": "variable.name.mtxbasic",
             "match": "\\b[A-Za-z_](\\$|[A-Za-z0-9_]*)\\b"
          },
          {
            "name": "constant.numeric.mtxbasic",
            "match": "-?\\b((([0-9]+\\.?[0-9]*)|(\\.[0-9]+))((e|E)(\\+|-)?[0-9]+)?)\\b"
          },
          {
             "name": "keyword.operator.arithmetic.mtxbasic",
             "match": "(&|\\*|\\-|\\+|=|<>|<|>|\\|\\^|<<|>>|~)"
          },
          {
            "name": "keyword.command.parameter.mtxbasic",
            "match": "(\\bCOLOUR\\s)(p|n)\\b"
          },   
          {
            "name": "keyword.command.parameter.mtxbasic",
            "match": "(\\bCRVS\\s)(n|t|x|y|w|h|s)\\b"
          },
          {
            "name": "variable.parameter.mtxbasic",
            "match": "(?<=\\bON\\s)([A-Za-z][A-Za-z0-9]*|\\d+)"
          },
          {
            "name": "keyword.control.mtxbasic",
            "match": "(?<=\\bON\\s(?:[A-Za-z][A-Za-z0-9]*|\\d+)\\s)(GOTO|GOSUB)\\b"
          },
          {
            "name": "constant.numeric.line-number.mtxbasic",
            "match": "(?<=\\bGOTO\\s|\\bGOSUB\\s)\\d{1,5}\\b"
          },
          {
            "name": "keyword.command.parameter.mtxbasic",
            "match": "\\bTIME\\$\\b"
          }
      ]
    },
    "strings": {
          "name": "string.quoted.double.mtxbasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
                "name": "constant.character.escape.zxbasic",
            "match": "\\\\."
            }
        ]
      }

  }
}
