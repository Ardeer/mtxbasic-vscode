{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mtxbasic",
  "scopeName": "source.mtxbasic",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#z80assembly" }
  ],
  "repository": {
    "keywords": {
            "patterns": [
          {
            "name": "keyword.control.mtxbasic",
            "match": "\\b(CONT|ELSE|FOR|GOSUB|GOTO|IF|NEXT|ON|PAUSE|RETURN|STEP|STOP|THEN|TO)\\b"
          },
          {
            "name": "keyword.command.mtxbasic",
            "match": "\\b(ADJSPR|ANGLE|ARC|ATTR|BAUD|CIRCLE|CLOCK|CLEAR|CLS|CODE|COLOUR|CRVS|CSR|CTLSPR|DATA|DIM|DRAW|DSI|EDITOR|GENPAT|INK|INPUT|LEN|LET|LINE|LPRINT|LOAD|MVSPR|NEW|NODDY|OUT|PAPER|PEEK|PHI|PI|PLOD|PLOT|POKE|PRINT|RAND|READ|REM|RESTORE|RND|RUN|SAVE|SBUF|SOUND|SPRITE|USER|VIEW|VS)\\b"
          },
          {
            "name": "keyword.other.mtxbasic",
            "match": "(?<![A-Za-z0-9_])(?:INKEY\\$|SPK\\$|TIME\\$)(?![A-Za-z0-9_])"
          },
          {
            "name": "entity.name.function.string.mtxbasic",
            "match": "(?<![A-Za-z0-9_])(?:CHR\\$|GR\\$|LEFT\\$|MID\\$|RIGHT\\$|STR\\$)(?![A-Za-z0-9_])"
          },          
          {
            "name": "entity.name.function.numeric.mtxbasic",
            "match": "\\b(ABS|ASC|ATN|COS|EXP|INP|INT|LN|MOD|SGN|SIN|SQR|TAN|USR|VAL)\\b"
          },           
          {
            "name": "illegal.keyword.control.mtxbasic",
            "match": "\\b(ASSEM|AUTO|EDIT|FRE|LIST|LLIST|PANEL|VERIFY)\\b"
          },
          {
            "name": "keyword.control.noddy.mtxbasic",
            "match": "\\*(?:ADVANCE|BRANCH|DISPLAY|ENTER|GOTO|IF|LIST|OFF|PAUSE|RETURN|RETURN)\\b"
        },
        {
            "name": "entity.name.tag.noddy.mtxbasic", 
            "match": "\\^\\w+"
        },
        {
            "name": "string.unquoted.noddy-title.mtxbasic",
            "match": "^Noddy page title is \\w+$"
        },
          {
            "name": "constant.numeric.line-number.mtxbasic",
            "match": "^(\\d{1,5})(?=\\s)"
          },
          {
            "name": "keyword.operator.arithmetic.mtxbasic",
            "match": "(\\+|\\-|\\*|/|\\^)"
          },
          {
            "name": "meta.brackets.parenthesis.mtxbasic",
            "match": "(\\(|\\))"
          },
          {
            "name": "keyword.operator.boolean.mtxbasic",
            "match": "\\b(AND|NOT|OR)\\b"
          },
          {
            "name": "keyword.operator.relational.mtxbasic",
            "match":"(<>|<=|>=|=|<|>)"
          },
          {
             "name": "variable.name.mtxbasic",
             "match": "\\b[A-Za-z0-9_][A-Za-z0-9_]*\\$?\\b"
          },            
          {
            "name": "constant.numeric.mtxbasic",
            "match": "-?\\b((([0-9]+\\.?[0-9]*)|(\\.[0-9]+))((e|E)(\\+|-)?[0-9]+)?)\\b"
          },
          { "name": "constant.hexadecimal.mtxbasic",
            "match": "\\b(#[0-9A-Fa-f_]+|£[0-9A-Fa-f_]+)\\b"
          },
          {
            "name": "keyword.control.mtxbasic",
            "match": "(?<=^\\s*(\\d{1,5})\\s*)\\bCODE\\s*$\\b"
          },        
          {
            "name": "variable.parameter.mtxbasic",
            "match": "(?<=\\bON)\\s([A-Za-z0-9_][A-Za-z0-9_]*|\\d+)"
          },
          {
            "name": "keyword.control.mtxbasic",
            "match": "(?<=\\bON\\s(?:[A-Za-z0-9_][A-Za-z0-9_]*|\\d+)\\s)(GOTO|GOSUB)\\b"
          },
          {
            "name": "constant.numeric.line-number.mtxbasic",
            "match": "(?<=\\b(GOTO|GOSUB)\\b)\\s*\\d{1,5}"
          }            
      ]
    },
    "strings": {
          "name": "string.quoted.double.mtxbasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
                "name": "constant.character.escape.mtxbasic",
            "match": "\\\\."
            }
        ]
      }, 
    "z80assembly": {
      "patterns": [
        {
          "name": "constant.numeric.hex-address.z80",
          "match": "^\\s+([0-9A-Fa-f_]{4})\\b"
        },
        {
          "name": "entity.name.label.z80",
          "match": "\\b([A-Za-z0-9_][A-Za-z0-9_]*):"
        },
        {
          "name": "keyword.mnemonic.z80",
          "match": "\\b(ADC|ADD|AND|BIT|CALL|CCF|CP|CPD|CPDR|CPI|CPIR|CPL|DAA|DEC|DI|DJNZ|EI|EX|EXX|HALT|IM|IN|INC|IND|INDR|INI|INIR|JP|JR|LD|LDD|LDDR|LDI|LDIR|NEG|NOP|OR|OTDR|OTIR|OUT|OUTD|OUTI|POP|PUSH|RES|RET|RETI|RETN|RL|RLA|RLC|RLCA|RLD|RR|RRA|RRC|RRCA|RRD|RST|SBC|SCF|SET|SLA|SRA|SRL|SUB|XOR)\\b"
        },
        {
          "name": "storage.register.z80",
          "match": "\\b(A|B|C|D|E|H|L|AF|BC|DE|HL|IX|IY|SP|PC|I|R)\\b"
        },
        {
          "name": "keyword.directive.z80",
          "match": "\\b(DB|DW|DS)\\b"
        },
        {
          "name": "constant.numeric.hex.z80",
          "match": "#[0-9A-Fa-f_]+"
        },
        {
          "name": "comment.line.semicolon.z80",
          "match": ";.*$"
        }
      ]
    }
  }
}
