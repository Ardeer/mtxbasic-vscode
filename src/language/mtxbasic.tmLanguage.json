{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mtxbasic",
  "scopeName": "source.mtxbasic",
  "patterns": [
    { "include": "#keywords" },
    { "include": "#strings" }
  ],
  "repository": {
    "keywords": {
            "patterns": [
          {
            "name": "keyword.control.mtxbasic",
            "match": "\\b(CONT|ELSE|FOR|GOSUB|GOTO|IF|LET|LOAD|NEXT|ON|PAUSE|RETURN|SAVE|STEP|STOP|THEN|TO)\\b"
          },
          {
            "name": "entity.name.function.mtxbasic",
            "match": "\\b(ABS|ADJSPR|ANGLE|ARC|ASC|ATN|ATTR|BAUD|CIRCLE|CLOCK|CLEAR|CLS|COLOUR|COS|CRVS|CSR|CTLSPR|DATA|DIM|DRAW|DSI|EXP|GENPAT|GR$|INK|INP|INPUT|INT|LEFT$|LEN|LINE|LN|LPRINT|MID$|OUT|MVSPR|PAPER|PEEK|PHI|PI|PLOD|PLOT|POKE|PRINT|RAND|READ|REM|RESTORE|RIGHT$|RND|ROM|SBUF|SGN|SIN|SOUND|SPK$|SPRITE|STR$|TAN|TIME$|USER|USR|VAL|VIEW|VS)\\b"
          },
          {
            "name": "illegal.keyword.control.mtxbasic",
            "match": "\\b(ASSEM|AUTO|EDIT|EDITOR|FRE|LIST|LLIST|NEW|NODDY|PANEL|RUN|VERIFY)\\b"
          },
          {
            "name": "constant.numeric.line-number.mtxbasic",
            "match": "^(\\d{1,5})(?=\\s)"
          },
          {
            "name": "keyword.operator.arithmetic.mtxbasic",
            "match": "(\\+|\\-|\\*|/|\\^)"
          },
          {
            "name": "meta.brackets.parenthesis.mtxbasic",
            "match": "(\\(|\\))"
          },
          {
            "name": "keyword.operator.boolean.mtxbasic",
            "match": "\\b(AND|MOD|NOT|OR)\\b"
          },
          {
            "name": "keyword.operator.relational.mtxbasic",
            "match": "(<>|<=|>=|=|<|>)"
          },
          {
            "name": "comment.line.rem.mtxbasic",
            "match": "(?i:(\\bREM\\b|').*)"
          },
          {
             "name": "variable.name.mtxbasic",
             "match": "\\b[A-Za-z_](\\$|[A-Za-z0-9_]*)"
          },
          {
            "name": "constant.numeric.mtxbasic",
            "match": "\\b\\d+(?:\\.\\d+)?\\b"
          },
          {
             "name": "keyword.operator.arithmetic.mtxbasic",
             "match": "(&|\\*|\\-|\\+|=|<>|<|>|\\|\\^|<<|>>|~)"
          }
      ]
    },
    "strings": {
          "name": "string.quoted.double.mtxbasic",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
                "name": "constant.character.escape.zxbasic",
            "match": "\\\\."
            }
        ]
      }

  }
}
